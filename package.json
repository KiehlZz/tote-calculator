{
  "name": "tote-calculator",
  "private": true,
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/generate-icons.mjs",
    "verify:pwa": "node scripts/verify-precache.mjs",
    "build:pages": "tsc && vite build --base=/tote-calculator/",
    "preview:pages": "vite preview --base=/tote-calculator/ --port 4174 --strictPort",
    "verify:base": "node scripts/verify-base.mjs /tote-calculator/",
    "check:pages": "npm test && npm run build:pages && npm run verify:pwa && npm run verify:base",
    "sample": "node scripts/make-sample-backup.mjs"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.7",
    "happy-dom": "^21.0.4",
    "sharp": "^0.35.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dexie": "^4.4.7"
  }
}
